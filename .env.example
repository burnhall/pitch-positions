# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# .env.local is ignored by git, so your keys never end up on GitHub.

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_). SERVER ONLY: never prefix with NEXT_PUBLIC_, never share it.
SUPABASE_SECRET_KEY=

# Long random string used to turn a player's PIN into their login password.
# Generate one with:  openssl rand -base64 32
PLAYER_PIN_PEPPER=
